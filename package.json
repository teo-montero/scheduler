{
  "name": "ucl-study-planner",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node -e \"process.env.TZ='Europe/London'; const tests=require('node:fs').readdirSync('tests').filter(name=>name.endsWith('.test.js')).map(name=>'tests/'+name); const result=require('node:child_process').spawnSync(process.execPath,['--test',...tests],{stdio:'inherit'}); process.exit(result.status ?? 1)\"",
    "check": "node --check src/dashboard.js && node --check src/background.js && npm test && npm run build",
    "test:browser": "npm run build && node tests/browser.mjs"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@playwright/test": "1.56.1"
  }
}
